# MorSaaS Environment Configuration
# Server Configuration
PORT=4000
NODE_ENV=development
DEPLOY_ENVIRONMENT=dev

# Redis Configuration
REDIS_URL=redis://localhost:6379
ALLOW_LOCAL_STORAGE=false

# API Base URL
VITE_API_BASE_URL=https://nfa-proxy-1081887913409.us-west1.run.app

# Default Model Configuration
REACT_APP_DEFAULT_MODEL_NAME=Llama-3.3-70B
REACT_APP_DEFAULT_MODEL_ID=meta-llama/llama-3.3-70b-instruct:free

# Secondary Endpoint (Fallback API) Configuration
SECONDARY_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions # for example
SECONDARY_ENDPOINT_TOKEN=your_api_key
SECONDARY_ENDPOINT_MODEL=openrouter/auto
USE_FALLBACK_AS_PRIMARY=true

# OpenRouter Integration
OPENROUTER_HTTP_REFERER=https://morsaas.com
OPENROUTER_APP_TITLE=MorSaaS
OPENROUTER_APP_VERSION=1.0.0

# Consumer API URL
CONSUMER_API_URL=https://consumer-node-1081887913409.us-west1.run.app

# GitHub Repository (for CI/CD)
GITHUB_REPO=srt0422/api-token-navigator

# Docker Configuration (optional)
# Uncomment these for Docker deployments
# HOST_PORT=8080
# CONTAINER_PORT=8080

# Restart Flag
RESTART=0 