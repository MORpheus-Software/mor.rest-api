# Backend API port configuration
PORT=4000

# Frontend API base URL configuration
# Used in development - overridden by proxy in vite.config.ts
VITE_API_BASE_URL=http://127.0.0.1:4000

# Redis configuration - Docker container
REDIS_URL=redis://localhost:6379

# Production API base URL - used when deployed
# VITE_API_BASE_URL=https://nfa-proxy-1081887913409.us-west1.run.app

