# Backend API port configuration
PORT=4000

# Frontend API base URL configuration
# Used in development - overridden by proxy in vite.config.ts
VITE_API_BASE_URL=http://127.0.0.1:4000

# Use the same Upstash Redis URL for both development and production
# This ensures consistency between development and production environments
REDIS_URL=redis://global:UPSTASH_SECRET@us1-engaged-cattle-39555.upstash.io:39555

# Upstash Redis REST API configuration (no longer needed, using direct Redis connection)
# UPSTASH_REST_API_DOMAIN=us1-engaged-cattle-39555.upstash.io
# UPSTASH_REST_API_TOKEN=YOUR_UPSTASH_TOKEN_HERE

# Uncomment and set this for local Redis if you want to switch back
# REDIS_URL=redis://localhost:6379

# Production API base URL - used when deployed
# VITE_API_BASE_URL=https://nfa-proxy-1081887913409.us-west1.run.app
